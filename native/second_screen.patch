+using PreferenceJson = nlohmann::json;
+PreferenceJson parseSecondScreenDevices(const std::string &text) {
+    if(text.size()>32768)throw std::runtime_error("专用桌面设置过大，原设置未改动");
+    try {
+        std::set<std::string> keys;
+        auto value=PreferenceJson::parse(text,[&keys](int,PreferenceJson::parse_event_t event,PreferenceJson &item){
+            if(event==PreferenceJson::parse_event_t::key && !keys.insert(item.get<std::string>()).second)
+                throw std::runtime_error("duplicate device");
+            return true;
+        });
+        if(!value.is_object() || value.size()>64)throw std::runtime_error("invalid devices");
+        for(auto it=value.begin();it!=value.end();++it)
+            if(!validSecondScreenDeviceId(it.key()) || !it.value().is_boolean())
+                throw std::runtime_error("invalid device preference");
+        return value;
+    }catch(const std::exception &){
+        throw std::runtime_error("专用桌面设置损坏，原设置未改动");
+    }
+}
+std::vector<std::string> preferenceConfigLines() {
+    errno=0;
+    FILE *file=std::fopen(kPath,"rb");
+    if(!file){
+        if(errno==ENOENT)return {};
+        throw std::runtime_error("无法读取专用桌面设置，原设置未改动");
+    }
+    std::string text;char buffer[4096];size_t n;
+    while((n=std::fread(buffer,1,sizeof buffer,file))!=0){
+        text.append(buffer,n);
+        if(text.size()>1024*1024){std::fclose(file);throw std::runtime_error("配置文件过大，原设置未改动");}
+    }
+    const bool failed=std::ferror(file)!=0;std::fclose(file);
+    if(failed)throw std::runtime_error("无法读取专用桌面设置，原设置未改动");
+    std::istringstream input(text);std::vector<std::string> lines;std::string line;
+    while(std::getline(input,line))lines.push_back(line);
+    return lines;
+}
