+bool secondScreenForDevice(const std::string &deviceId) {
+    if(!validSecondScreenDeviceId(deviceId))throw std::invalid_argument("Invalid second-screen device ID");
+    // reload() owns the first-wins interpretation for the entire config file.
+    const auto &store=ConfigStore::instance();
+    if(!store.has("second_screen_devices"))return false;
+    const auto devices=parseSecondScreenDevices(store.value("second_screen_devices"));
+    const auto found=devices.find(deviceId);
+    return found!=devices.end() && found->get<bool>();
+}
+void saveSecondScreenForDevice(const std::string &deviceId,bool enabled) {
+    if(!validSecondScreenDeviceId(deviceId))throw std::invalid_argument("Invalid second-screen device ID");
+    std::lock_guard lock(configWriteMutex);
+    const auto lines=preferenceConfigLines();
+    auto devices=PreferenceJson::object();bool found=false;
+    for(const auto &line:lines)if(config::keyOf(line)=="second_screen_devices" && !found){
+        devices=parseSecondScreenDevices(config::valueOf(line));found=true;
+    }
+    if(enabled){
+        if(!devices.contains(deviceId) && devices.size()>=64)
+            throw std::runtime_error("已保存 64 台电脑的专用桌面设置");
+        devices[deviceId]=true;
+    }else devices.erase(deviceId);
+    std::string content;
+    for(const auto &line:lines)if(config::keyOf(line)!="second_screen_devices")content+=line+'\n';
+    content+="second_screen_devices="+devices.dump()+'\n';
+    if(!writeAtomic(content))throw std::runtime_error("专用桌面设置保存失败，未切换连接");
+#ifdef __SWITCH__
+    if(R_FAILED(fsdevCommitDevice("sdmc")))throw std::runtime_error("专用桌面设置写入未确认，未切换连接");
+#endif
+    ConfigStore::instance().reload();
+    const auto &stored=ConfigStore::instance();
+    if(!stored.has("second_screen_devices") || parseSecondScreenDevices(stored.value("second_screen_devices"))!=devices)
+        throw std::runtime_error("专用桌面设置回读不一致，未切换连接");
+}
