+// Stable service device identifiers, never display numbers or session UUIDs.
+inline bool validSecondScreenDeviceId(const std::string &id) {
+    if(id.empty() || id.size()>256)return false;
+    const auto alnum=[](unsigned char c){return (c>='a'&&c<='z') || (c>='A'&&c<='Z') || (c>='0'&&c<='9');};
+    if(!alnum(static_cast<unsigned char>(id.front())))return false;
+    return std::all_of(id.begin(),id.end(),[&](unsigned char c){return alnum(c) || c=='-' || c=='_' || c=='.' || c==':';});
+}
