+void Media::setFrameWake(Uint32 eventType, Uint32 windowId) {
+    if(eventType && impl_->frameWakeEvent.load()==eventType && impl_->frameWakeWindow.load()==windowId) {
+        // A renderer reset only acknowledges the hint. Keep registration live
+        // so a concurrent publication cannot fall into a disable/re-enable gap.
+        impl_->frameWakePending.store(false);return;
+    }
+    const Uint32 previous=impl_->frameWakeEvent.exchange(0);
+    impl_->frameWakePending.store(false);
+    if(previous)SDL_FlushEvent(previous);
+    impl_->frameWakeWindow.store(windowId);
+    if(eventType>=SDL_USEREVENT && eventType<SDL_LASTEVENT)
+        impl_->frameWakeEvent.store(eventType);
+}
