+// Both the correlated response and the asynchronous host notification use
+// the same three protobuf fields. Only cur_privacy_type describes reality.
+static bool readPrivacyState(const Field &body,PrivacyRpcAck &out) {
+    Reader reader(body.data,body.size);Field f;unsigned seen=0;
+    while(reader.next(f)){
+        if(f.key<1 || f.key>3)continue;
+        const auto bit=1u<<f.key;
+        if((seen&bit) || f.wire!=0)return false;
+        seen|=bit;
+        if(f.key==1)out.errorCode=int(int32_t(f.value));
+        else {
+            if(f.value>3)return false;
+            auto mode=static_cast<PrivacyMode>(f.value);
+            if(f.key==2)out.requestedMode=mode;
+            else out.currentMode=mode;
+        }
+    }
+    return reader.good();
+}
+std::optional<PrivacyRpcAck> parsePrivacyScreenState(const uint8_t *data,size_t size) noexcept{
+    if(!data || !size || size>65536)return {};
+    Reader message(data,size);Field outer;bool system=false,body=false;PrivacyRpcAck out;
+    while(message.next(outer))if(outer.key==15){
+        if(system || outer.wire!=2)return {};
+        system=true;Reader change(outer.data,outer.size);Field f;
+        while(change.next(f))if(f.key==5){
+            if(body || f.wire!=2 || !readPrivacyState(f,out))return {};
+            body=true;
+        }
+        if(!change.good())return {};
+    }
+    if(!message.good() || !body)return {};
+    return out;
+}
